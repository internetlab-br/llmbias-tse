# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual env
.venv

# Secrets
.env

# Perfil persistente do Chrome (cookies/sessões pessoais) e dados coletados
tmp/
data/

# Proposta interna de parceria — NÃO publicar (repo público)
docs/*.docx

# Artefatos de ferramentas locais (Playwright MCP, etc.)
.playwright-mcp/

# Material operacional interno — NÃO publicar (repo público).
# O prompt de operação diz quem roda o quê, em que conta, e como
# contornar os limites das plataformas: é procedimento da equipe,
# não metodologia. A metodologia é que tem de ser pública.
docs/interno/

# Perfis do Chrome das estações de coleta: contêm SESSÃO LOGADA das contas.
# Nunca versionar.
infra/local/perfis/
infra/local/.env

# Passagem de bastão entre máquinas: mesma razão do bloco acima (nomeia
# contas e conta o histórico de banimento), mais ~10 GB de zips de coleta
# que não têm o que fazer num repositório de código.
handoff/
HANDOFF.md
infra/local/.env.*
