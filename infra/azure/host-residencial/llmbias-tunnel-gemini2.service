[Unit]
Description=llmbias: tunel SOCKS reverso para vm-gemini2 (IP_DA_VM_GEMINI2)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -R 1080 -i %h/.ssh/llmbias_azure   -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3   -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=%h/.ssh/known_hosts_llmbias   azureuser@IP_DA_VM_GEMINI2
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
